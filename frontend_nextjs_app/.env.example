# PUBLIC_INTERFACE
# NEXT_PUBLIC_BACKEND_URL
# URL of the Express backend API (protocol + host [+ :port])
# Example for local dev:
# NEXT_PUBLIC_BACKEND_URL=http://localhost:3001
#
# Example for cloud / container environment (same host, API on 3001):
# NEXT_PUBLIC_BACKEND_URL=https://your-host.example.com:3001

NEXT_PUBLIC_BACKEND_URL=
